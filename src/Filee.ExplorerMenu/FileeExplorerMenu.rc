// Version information of the Explorer context-menu DLL. build/build-explorer-menu.ps1 passes the app version as
// FILEE_VERSION_MAJOR/MINOR/PATCH and FILEE_VERSION_TEXT.

#include <winver.h>

#ifndef TULEZ_VERSION_MAJOR
#define TULEZ_VERSION_MAJOR 0
#define TULEZ_VERSION_MINOR 0
#define TULEZ_VERSION_PATCH 0
#define TULEZ_VERSION_TEXT "0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION TULEZ_VERSION_MAJOR, TULEZ_VERSION_MINOR, TULEZ_VERSION_PATCH, 0
PRODUCTVERSION TULEZ_VERSION_MAJOR, TULEZ_VERSION_MINOR, TULEZ_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Tulez"
            VALUE "FileDescription", "Tulez File Explorer context menu"
            VALUE "FileVersion", TULEZ_VERSION_TEXT
            VALUE "InternalName", "FileeExplorerMenu"
            VALUE "LegalCopyright", "Copyright (c) Filee contributors. MIT License."
            VALUE "OriginalFilename", "FileeExplorerMenu.dll"
            VALUE "ProductName", "Tulez"
            VALUE "ProductVersion", TULEZ_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
